"use client";
import React, { useState, useEffect } from 'react';

export default function PracticeHub() {
  const [breath, setBreath] = useState("Inhale");
  const [pulse, setPulse] = useState(false);

  // Solar Sync Logic (6-second cycles)
  useEffect(() => {
    const interval = setInterval(() => {
      setBreath(prev => prev === "Inhale" ? "Exhale" : "Inhale");
      setPulse(true);
      setTimeout(() => setPulse(false), 1000);
    }, 3000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="min-h-screen bg-[#020617] text-teal-100 font-mono p-6 overflow-hidden">
      
      {/* 1. THE DIVINE DATA TICKER */}
      <div className="fixed top-0 left-0 w-full bg-teal-950/30 border-b border-teal-500/20 py-2 z-50">
        <div className="whitespace-nowrap animate-scroll">
          <span className="mx-8 opacity-50">MINERAL ESSENCE: GROUNDED</span>
          <span className="mx-8 opacity-50">PLANT VITALITY: ASCENDING</span>
          <span className="mx-8 opacity-50">ANIMAL SENTIENCE: PROTECTED</span>
          <span className="mx-8 opacity-50">SYSTEM STATUS: TOTAL SYNCHRONICITY</span>
        </div>
      </div>

      <div className="max-w-6xl mx-auto pt-20 grid lg:grid-cols-2 gap-12">
        
        {/* 2. THE SOLAR SYNC (Breathing Tool) */}
        <section className="flex flex-col items-center justify-center p-12 rounded-3xl bg-slate-900/20 border border-teal-500/10">
          <h2 className="text-xs tracking-[0.5em] uppercase mb-12 opacity-50">Solar Broadcast Sync</h2>
          <div className={`w-64 h-64 rounded-full border-2 flex items-center justify-center transition-all duration-[3000ms] ${breath === "Inhale" ? "scale-110 border-teal-400 shadow-[0_0_50px_rgba(45,212,191,0.2)]" : "scale-90 border-teal-900 shadow-none"}`}>
            <span className="text-2xl font-light tracking-widest animate-pulse">{breath}</span>
          </div>
          <p className="mt-12 text-[10px] text-slate-500 text-center max-w-xs leading-relaxed">
            ALIGN YOUR BIOLOGICAL FREQUENCY WITH THE SOLAR EMISSION.
          </p>
        </section>

        {/* 3. THE STEWARDSHIP VAULT (The Log) */}
        <section className="space-y-6">
          <h2 className="text-xs tracking-[0.5em] uppercase opacity-50 mb-8">Stewardship Vault</h2>
          
          {['Mineral', 'Plant', 'Animal'].map((type) => (
            <div key={type} className="group p-6 rounded-xl bg-slate-900/40 border border-white/5 hover:border-teal-500/30 transition-all">
              <div className="flex justify-between items-center mb-4">
                <span className="text-sm font-bold tracking-widest">{type} ACT</span>
                <span className="text-[10px] opacity-30">ENCRYPTING...</span>
              </div>
              <textarea 
                className="w-full bg-transparent border-b border-white/10 focus:border-teal-500 outline-none text-sm font-sans py-2 text-slate-400"
                placeholder={`Document your ${type.toLowerCase()} protection here...`}
              />
            </div>
          ))}
          
          <button className="w-full py-4 bg-teal-500/10 border border-teal-500/50 hover:bg-teal-500 hover:text-black transition-all text-xs font-bold tracking-[0.3em] uppercase">
            Commit to the Essence
          </button>
        </section>
      </div>

      {/* Ticker Animation */}
      <style jsx>{`
        @keyframes scroll {
          0% { transform: translateX(100%); }
          100% { transform: translateX(-100%); }
        }
        .animate-scroll {
          display: inline-block;
          animation: scroll 20s linear infinite;
        }
      `}</style>
    </div>
